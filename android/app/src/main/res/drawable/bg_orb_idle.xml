<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Subtle outer ambient glow -->
    <item>
        <shape android:shape="oval">
            <solid android:color="#267FE7D6" />
        </shape>
    </item>
    <!-- Inner core glass sphere -->
    <item android:bottom="4dp" android:left="4dp" android:right="4dp" android:top="4dp">
        <shape android:shape="oval">
            <gradient
                android:angle="135"
                android:endColor="#D9161920"
                android:startColor="#F22A3342"
                android:type="linear" />
            <stroke
                android:width="1.5dp"
                android:color="#807FE7D6" />
        </shape>
    </item>
</layer-list>
