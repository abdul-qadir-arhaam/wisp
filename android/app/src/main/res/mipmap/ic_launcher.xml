<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <solid android:color="#0E1116" />
        </shape>
    </item>
    <item android:bottom="8dp" android:left="8dp" android:right="8dp" android:top="8dp">
        <shape android:shape="oval">
            <solid android:color="#267FE7D6" />
        </shape>
    </item>
    <item android:bottom="14dp" android:left="14dp" android:right="14dp" android:top="14dp">
        <shape android:shape="oval">
            <gradient
                android:angle="135"
                android:endColor="#7FE7D6"
                android:startColor="#A78BFA"
                android:type="linear" />
            <stroke
                android:width="2dp"
                android:color="#FFFFFF" />
        </shape>
    </item>
</layer-list>
