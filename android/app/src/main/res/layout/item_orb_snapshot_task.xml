<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="6dp"
    android:background="@drawable/bg_glass_item"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="10dp">

    <TextView
        android:id="@+id/tvTaskIndicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="8dp"
        android:text="○"
        android:textColor="@color/wisp_accent"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/tvTaskContent"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="Call client regarding project update"
        android:textColor="@color/wisp_text_primary"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/tvTaskDue"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:background="#267FE7D6"
        android:paddingHorizontal="6dp"
        android:paddingVertical="2dp"
        android:text="Tomorrow"
        android:textColor="@color/wisp_accent"
        android:textSize="10sp"
        android:visibility="gone" />
</LinearLayout>
