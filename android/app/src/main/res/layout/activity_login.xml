<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/wisp_background"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- Glowing Orb Motif -->
    <FrameLayout
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:background="@drawable/bg_orb_idle">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="✦"
            android:textColor="@color/wisp_accent"
            android:textSize="28sp" />
    </FrameLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Wisp"
        android:textColor="@color/wisp_text_primary"
        android:textSize="26sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Speak a thought once. Sync everywhere."
        android:textColor="@color/wisp_text_secondary"
        android:textSize="14sp" />

    <!-- Glassmorphic Login Card -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        app:cardBackgroundColor="@color/wisp_surface_card"
        app:cardCornerRadius="20dp"
        app:strokeColor="@color/wisp_border"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:id="@+id/tvAuthModeTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sign In to Your Account"
                android:textColor="@color/wisp_text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etLoginEmail"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_input_field"
                android:hint="@string/email_hint"
                android:inputType="textEmailAddress"
                android:paddingHorizontal="14dp"
                android:textColor="@color/wisp_text_primary"
                android:textColorHint="@color/wisp_text_secondary"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/etLoginPassword"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_input_field"
                android:hint="@string/password_hint"
                android:inputType="textPassword"
                android:paddingHorizontal="14dp"
                android:textColor="@color/wisp_text_primary"
                android:textColorHint="@color/wisp_text_secondary"
                android:textSize="14sp" />

            <!-- Primary Auth Submit Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLoginSubmit"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="16dp"
                android:backgroundTint="@color/wisp_accent"
                android:text="Sign In"
                android:textColor="@color/wisp_background"
                android:textSize="15sp"
                android:textStyle="bold"
                app:cornerRadius="12dp" />

            <!-- Sign in with Google (PRD Section 7.1.4) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnGoogleSignIn"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="10dp"
                android:text="Sign in with Google"
                android:textColor="@color/wisp_text_primary"
                android:textSize="14sp"
                app:cornerRadius="12dp"
                app:strokeColor="@color/wisp_border" />

            <TextView
                android:id="@+id/tvToggleSignUp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="16dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:padding="6dp"
                android:text="Don't have an account? Sign up"
                android:textColor="@color/wisp_accent"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvLoginError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:textColor="@color/wisp_warning"
                android:textSize="12sp"
                android:visibility="gone" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</LinearLayout>
